{
  "info": {
    "name": "Apaleo Sandbox - Concigo Integration",
    "_postman_id": "apaleo-concigo-sandbox-v1",
    "description": "Ready-to-test Postman collection for Apaleo Sandbox PMS endpoints (Properties, Reservations, Check-In, Check-Out, and Folio Upsell Charges).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "oauth2",
    "oauth2": [
      {
        "key": "grant_type",
        "value": "authorization_code",
        "type": "string"
      },
      {
        "key": "authUrl",
        "value": "https://identity.apaleo.com/connect/authorize",
        "type": "string"
      },
      {
        "key": "accessTokenUrl",
        "value": "https://identity.apaleo.com/connect/token",
        "type": "string"
      },
      {
        "key": "clientId",
        "value": "ZIKG-AC-CONCIGOAPP",
        "type": "string"
      },
      {
        "key": "clientSecret",
        "value": "n4cUcFMBSBLpmDge3YzeDW4FqGzBBo",
        "type": "string"
      },
      {
        "key": "redirect_uri",
        "value": "https://oauth.pstmn.io/v1/callback",
        "type": "string"
      },
      {
        "key": "scope",
        "value": "openid offline_access reservations.read reservations.manage availability.read availability.manage folios.read folios.manage",
        "type": "string"
      },
      {
        "key": "tokenName",
        "value": "Apaleo Sandbox Token",
        "type": "string"
      },
      {
        "key": "addTokenTo",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. GET Properties (Hotels)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://api.apaleo.com/inventory/v1/properties",
          "protocol": "https",
          "host": ["api", "apaleo", "com"],
          "path": ["inventory", "v1", "properties"]
        },
        "description": "Fetches all 5 test properties: BER (Berlin), LND (London), MUC (Munich), PAR (Paris), VIE (Vienna)."
      }
    },
    {
      "name": "2. GET Live Reservations",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://api.apaleo.com/booking/v1/reservations?propertyId=BER",
          "protocol": "https",
          "host": ["api", "apaleo", "com"],
          "path": ["booking", "v1", "reservations"],
          "query": [
            {
              "key": "propertyId",
              "value": "BER",
              "description": "Filter by property (BER, LND, MUC, PAR, VIE)"
            }
          ]
        },
        "description": "Fetches all live bookings, guests, assigned room numbers, and balances."
      }
    },
    {
      "name": "3. POST Folio Charge (Early Check-In / Pass)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reservationId\": \"VISOAOJC-1\",\n  \"amount\": {\n    \"amount\": 25.00,\n    \"currency\": \"EUR\"\n  },\n  \"name\": \"Concigo Early Check-In Pass\",\n  \"serviceType\": \"Extra\"\n}"
        },
        "url": {
          "raw": "https://api.apaleo.com/folio/v1/charges",
          "protocol": "https",
          "host": ["api", "apaleo", "com"],
          "path": ["folio", "v1", "charges"]
        },
        "description": "Posts an upsell pass charge (e.g. 25 EUR Early Check-In) directly to the guest's folio/bill in Apaleo."
      }
    },
    {
      "name": "4. PUT Digital Check-In",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}"
        },
        "url": {
          "raw": "https://api.apaleo.com/booking/v1/reservation-actions/ZVIQUJXO-1/check-in",
          "protocol": "https",
          "host": ["api", "apaleo", "com"],
          "path": ["booking", "v1", "reservation-actions", "ZVIQUJXO-1", "check-in"]
        },
        "description": "Executes digital check-in for reservation ZVIQUJXO-1, moving its status from Confirmed to InHouse."
      }
    },
    {
      "name": "5. POST Create New Test Reservation",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"propertyId\": \"BER\",\n  \"unitGroupId\": \"BER-DBL\",\n  \"arrival\": \"2026-09-22T14:00:00+02:00\",\n  \"departure\": \"2026-09-25T11:00:00+02:00\",\n  \"adults\": 2,\n  \"primaryGuest\": {\n    \"firstName\": \"Alex\",\n    \"lastName\": \"Morgan\",\n    \"email\": \"alex.morgan@test.com\",\n    \"phone\": \"+919876543210\"\n  }\n}"
        },
        "url": {
          "raw": "https://api.apaleo.com/booking/v1/reservations",
          "protocol": "https",
          "host": ["api", "apaleo", "com"],
          "path": ["booking", "v1", "reservations"]
        },
        "description": "Creates a fresh reservation in Hotel Berlin under Double room category."
      }
    }
  ]
}
